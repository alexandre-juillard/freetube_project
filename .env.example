# Configuration de l'environnement Freetube
# Copier ce fichier vers .env et remplir les valeurs

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=freetube_user
DB_PASSWORD=your_secure_password_here
DB_NAME=freetube_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=100MB

# Frontend URL
FRONTEND_URL=http://localhost:4200

# Backend Configuration
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGIN=http://localhost:4200

# Sécurité
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Docker Configuration (pour docker-compose)
POSTGRES_USER=freetube_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=freetube_db
